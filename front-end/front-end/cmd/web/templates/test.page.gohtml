{{template "base" .}}

{{define "content"}}
<div class="container py-5" style="max-width: 900px;">
    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1a1a1a; letter-spacing: -0.5px;">Microservice Playground</h2>
            <p class="text-muted mb-0">Test and monitor your broker service communication in real-time.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button id="brokerBtn" class="btn px-4 py-2 fw-semibold text-white shadow-sm" style="background-color: #ff6d5a; border-color: #ff6d5a; border-radius: 8px;">
                <i class="bi bi-play-fill me-1"></i> Test Broker
            </button>
            <button id="authBrokerBtn" class="btn px-4 py-2 fw-semibold text-white shadow-sm" style="background-color: #ff6d5a; border-color: #ff6d5a; border-radius: 8px;">
                <i class="bi bi-play-fill me-1"></i> Test Auth
            </button>
            <button id="createUserBtn" class="btn px-4 py-2 fw-semibold text-white shadow-sm" style="background-color: #2563eb; border-color: #2563eb; border-radius: 8px;">
                <i class="bi bi-person-plus-fill me-1"></i> Create User
            </button>
            <button id="logBtn" class="btn px-4 py-2 fw-semibold text-white shadow-sm" style="background-color: #ff6d5a; border-color: #ff6d5a; border-radius: 8px;">
                <i class="bi bi-play-fill me-1"></i> Test Log
            </button>
        </div>
    </div>

    <!-- Main Output Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff; border: 1px solid #eaeaea !important;">
        <div class="card-body p-4">
            <h6 class="text-uppercase text-muted fw-bold mb-3" style="letter-spacing: 0.5px; font-size: 0.75rem;">Live Execution Output</h6>
            <div id="output" class="p-3 rounded-3 font-monospace fs-6" style="background: #f8f9fa; border: 1px solid #e5e7eb; color: #374151; min-height: 80px; max-height: 200px; overflow-y: auto;">
                <span class="text-muted fst-italic">Waiting for execution... Click a test button to start.</span>
            </div>
        </div>
    </div>

    <!-- Payload & Response Grid -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff; border: 1px solid #eaeaea !important;">
                <div class="card-body p-4 d-flex flex-column">
                    <h6 class="text-uppercase text-muted fw-bold mb-3" style="letter-spacing: 0.5px; font-size: 0.75rem;">Sent Payload</h6>
                    <div class="p-3 rounded-3 flex-grow-1" style="background: #f8f9fa; border: 1px solid #e5e7eb; max-height: 250px; overflow-y: auto;">
                        <pre id="payload" class="m-0 fs-7 font-monospace" style="color: #2563eb;"><span class="text-muted fst-italic">Nothing sent yet...</span></pre>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff; border: 1px solid #eaeaea !important;">
                <div class="card-body p-4 d-flex flex-column">
                    <h6 class="text-uppercase text-muted fw-bold mb-3" style="letter-spacing: 0.5px; font-size: 0.75rem;">Received Response</h6>
                    <div class="p-3 rounded-3 flex-grow-1" style="background: #f8f9fa; border: 1px solid #e5e7eb; max-height: 250px; overflow-y: auto;">
                        <pre id="received" class="m-0 fs-7 font-monospace" style="color: #059669;"><span class="text-muted fst-italic">Nothing received yet...</span></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "js"}}
<script>
    const brokerBtn = document.getElementById("brokerBtn");
    const authBrokerBtn = document.getElementById("authBrokerBtn");
    const createUserBtn = document.getElementById("createUserBtn");
    const logBtn = document.getElementById("logBtn");
    const output = document.getElementById("output");
    const payloadEl = document.getElementById("payload");
    const received = document.getElementById("received");

    // 1. Test Broker Service thông thường
    brokerBtn.addEventListener("click", function() {
        const requestOptions = {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            }
        };

        payloadEl.innerHTML = JSON.stringify({ method: "POST", endpoint: "http://localhost:8080" }, null, 4);
        output.innerHTML = `<span class="text-warning fw-semibold">Connecting to broker service...</span>`;

        fetch("http://localhost:8080", requestOptions)
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then((data) => {
                received.innerHTML = JSON.stringify(data, null, 4);
                
                if (data.error) {
                    output.innerHTML = `<span class="text-danger fw-semibold">Error: ${data.message}</span>`;
                } else {
                    output.innerHTML = `<span class="text-success fw-semibold">Success: ${data.message}</span>`;
                }
            })
            .catch((error) => {
                output.innerHTML = `<span class="text-danger fw-semibold">Connection Failed: ${error.message}</span>`;
                received.innerHTML = `<span class="text-danger">Error fetching data from server.</span>`;
            });
    });

    // 2. Test Auth Service qua Broker (/handle)
    authBrokerBtn.addEventListener("click", function() {
        const payload = {
            action: "auth",
            auth: {
                email: "admin@example.com",
                password: "verysecret",
            }
        };

        const requestOptions = {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: {
                "Content-Type": "application/json"
            }
        };

        payloadEl.innerHTML = JSON.stringify(payload, null, 4);
        output.innerHTML = `<span class="text-warning fw-semibold">Connecting to broker service (/handle)...</span>`;

        fetch("http://localhost:8080/handle", requestOptions)
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then((data) => {
                received.innerHTML = JSON.stringify(data, null, 4);
                
                if (data.error) {
                    output.innerHTML = `<span class="text-danger fw-semibold">Error: ${data.message}</span>`;
                } else {
                    output.innerHTML = `<span class="text-success fw-semibold">Success: ${data.message}</span>`;
                }
            })
            .catch((error) => {
                output.innerHTML = `<span class="text-danger fw-semibold">Connection Failed: ${error.message}</span>`;
                received.innerHTML = `<span class="text-danger">Error fetching data from server.</span>`;
            });
    });

    // 3. Test Create User Service qua Broker (/handle)
    createUserBtn.addEventListener("click", function() {
        const payload = {
            action: "create_user",
            user: {
                email: "admin@example.com",
                first_name: "Admin",
                last_name: "User",
                password: "verysecret",
                user_active: 1
            }
        };

        const requestOptions = {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: {
                "Content-Type": "application/json"
            }
        };

        payloadEl.innerHTML = JSON.stringify(payload, null, 4);
        output.innerHTML = `<span class="text-warning fw-semibold">Creating user in database...</span>`;

        fetch("http://localhost:8080/handle", requestOptions)
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then((data) => {
                received.innerHTML = JSON.stringify(data, null, 4);
                
                if (data.error) {
                    output.innerHTML = `<span class="text-danger fw-semibold">Error: ${data.message}</span>`;
                } else {
                    output.innerHTML = `<span class="text-success fw-semibold">Success: User created successfully! Now you can click Test Auth.</span>`;
                }
            })
            .catch((error) => {
                output.innerHTML = `<span class="text-danger fw-semibold">Connection Failed: ${error.message}</span>`;
                received.innerHTML = `<span class="text-danger">Error fetching data from server.</span>`;
            });
    });

    // 4. Test Log Service qua Broker (/handle)
    logBtn.addEventListener("click", function() {
        const payload = {
            action: "log",
            log: {
                name: "event",
                data: "Some kinds of data",
            }
        };

        const requestOptions = {
            method: "POST",
            body: JSON.stringify(payload),
            headers: {
                "Content-Type": "application/json"
            }
        };

        payloadEl.innerHTML = JSON.stringify(payload, null, 4);
        output.innerHTML = `<span class="text-warning fw-semibold">Connecting to broker service (/handle) for logging...</span>`;

        fetch("http://localhost:8080/handle", requestOptions)
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then((data) => {
                received.innerHTML = JSON.stringify(data, null, 4);
                
                if (data.error) {
                    output.innerHTML = `<span class="text-danger fw-semibold">Error: ${data.message}</span>`;
                } else {
                    output.innerHTML = `<span class="text-success fw-semibold">Success: ${data.message}</span>`;
                }
            })
            .catch((error) => {
                output.innerHTML = `<span class="text-danger fw-semibold">Connection Failed: ${error.message}</span>`;
                received.innerHTML = `<span class="text-danger">Error fetching data from server.</span>`;
            });
    });
</script>
{{end}}